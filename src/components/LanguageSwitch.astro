---
interface Props {
  hasEnglish: boolean;
}

const { hasEnglish } = Astro.props;
---

{
  hasEnglish && (
    <button type="button" class="language-switch language-pair" data-language-toggle aria-label="切换到英文 / Switch to English">
      <span data-lang="zh">English</span>
      <span data-lang="en">中文</span>
    </button>
  )
}
